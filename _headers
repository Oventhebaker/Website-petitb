# Cloudflare Pages response headers.
# By default Pages lets browsers keep a file 4 hours, then re-checks it:
# a returning visitor re-asks the server about every image. Photos, fonts
# and the video don't change once published (a replaced photo gets a new
# name, or wait a week), so browsers keep them a week, and keep using
# them while re-checking for a day after that. The page itself and its
# scripts keep Pages' default, so a deploy shows up right away.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
